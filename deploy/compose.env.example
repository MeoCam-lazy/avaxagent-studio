# Compose-level settings for docker-compose.yml (not the backend's settings).
# Copy to `.env` in the repo root: `cp deploy/compose.env.example .env`.
# Backend settings live in apps/backend/.env (copy apps/backend/.env.example).

# Postgres password; the stack builds DATABASE_URL from it.
POSTGRES_PASSWORD=change-me

# Caddy site addresses.
#   Local:  STUDIO_SITE=:80 and GATEWAY_SITE=:8001 (plain HTTP)
#   Server: real hostnames whose DNS points at the server; Caddy gets HTTPS certs.
STUDIO_SITE=studio.example.com
GATEWAY_SITE=gateway.example.com

# Host ports. Keep 80/443 on a server (needed for HTTPS certificates).
HTTP_PORT=80
HTTPS_PORT=443
GATEWAY_PORT=8001
# Loopback-only ports for Postgres / Redis (change if already taken locally).
POSTGRES_PORT=5432
REDIS_PORT=6379
