# Copy this file to deploy/oci.env and fill in the values below.
# This file is for creating a new Oracle Cloud VM. Do not paste private key contents here.

# OCI API signing key and account
OCI_TENANCY_OCID=...
OCI_USER_OCID=...
OCI_FINGERPRINT=...
OCI_PRIVATE_KEY_PATH=...
# Always Free VMs must be in the tenancy home region.
OCI_REGION=...

# Empty compartment means the root compartment (OCI_TENANCY_OCID).
OCI_COMPARTMENT_OCID=

# The deploy script will create the VCN, public subnet, internet gateway and rules.
OCI_VCN_CIDR=10.0.0.0/16
OCI_SUBNET_CIDR=10.0.1.0/24
# Optional: leave empty to detect this machine's public IPv4 and use /32 for SSH.
OCI_SSH_SOURCE_CIDR=

# SSH key pair used to access the new Ubuntu VM
OCI_SSH_PUBLIC_KEY_PATH=...
OCI_SSH_PRIVATE_KEY_PATH=...

# DNS names that you will point to the VM's public IP after creation.
STUDIO_DOMAIN=...
GATEWAY_DOMAIN=...

# VM size. Ampere A1 uses ARM64; these values fit the current Always Free total.
# For a paid VM using Free Trial credit, VM.Standard.E5.Flex with 1 OCPU and
# 8 GB RAM is an x86 option. Check pricing and trial balance before applying.
OCI_SHAPE=VM.Standard.A1.Flex
OCI_OCPUS=2
OCI_MEMORY_GB=12
