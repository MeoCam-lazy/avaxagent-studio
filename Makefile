.PHONY: install infra api gateway indexer worker settler migrate revision test lint web web-build contracts-test contracts-deploy-fuji fuji-fork test-fuji-fork test-fuji

install:            ## Install Python workspace + frontend deps
	uv sync --all-packages --all-extras
	pnpm install

infra:              ## Start Postgres + Redis
	docker compose up -d postgres redis

api:                ## Control plane REST API (http://localhost:8000/docs)
	cd apps/backend && uv run uvicorn app.main:app --reload --port 8000

gateway:            ## A2A gateway (http://localhost:8001)
	cd apps/backend && uv run uvicorn app.data_plane.gateway.main:app --reload --port 8001

indexer:            ## Chain indexer (Avalanche C-Chain event listener)
	cd apps/backend && uv run python -m app.data_plane.indexer

worker:             ## Job workers (arq on Redis)
	cd apps/backend && uv run arq app.data_plane.workers.settings.WorkerSettings

settler:            ## Settle bot
	cd apps/backend && uv run python -m app.data_plane.settler

migrate:            ## Apply DB migrations
	cd apps/backend && uv run alembic upgrade head

revision:           ## New autogenerated migration: make revision m="message"
	cd apps/backend && uv run alembic revision --autogenerate -m "$(m)"

test:
	cd apps/backend && uv run pytest
	cd packages/avaxagent-sdk && uv run pytest -q

FOUNDRY_IMAGE ?= ghcr.io/foundry-rs/foundry:v1.2.3
FUJI_RPC ?= https://api.avax-test.network/ext/bc/C/rpc

fuji-fork:          ## Local fork of Fuji on :8545 (anvil in Docker)
	docker run -d --rm --name avaxagent-anvil -p 8545:8545 $(FOUNDRY_IMAGE) 		"anvil --host 0.0.0.0 --fork-url $(FUJI_RPC) --chain-id 43113 --block-time 1"

test-fuji-fork:     ## Fuji E2E suite against the fork (no keys or faucet needed)
	cd apps/backend && FUJI_E2E=1 FUJI_FORK=1 RPC_URL=http://localhost:8545 uv run pytest tests/fuji -v

test-fuji:          ## Fuji E2E suite on live Fuji (needs FUJI_*_KEY, see docs/FUJI_E2E.md)
	cd apps/backend && FUJI_E2E=1 uv run pytest tests/fuji -v

lint:
	uv run ruff check apps/backend
	pnpm lint:web

web:                ## Frontend dev server (http://localhost:5173)
	pnpm dev:web

web-build:
	pnpm build:web

contracts-test:     ## Run Foundry tests for ERC-8183 contracts
	cd contracts && forge test -vv

contracts-deploy-fuji: ## Deploy ERC-8183 stack to Avalanche Fuji
	cd contracts && forge script script/Deploy.s.sol:Deploy --rpc-url fuji --broadcast --verify
