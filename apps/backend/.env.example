# ==============================================================================
# Avaxagent Studio — Backend Environment Configuration (apps/backend/.env)
# ==============================================================================
# Copy this file to `apps/backend/.env` and customize values for your environment:
#   cp apps/backend/.env.example apps/backend/.env

# ── Application & CORS ───────────────────────────────────────────────────────
APP_NAME="Avaxagent Studio"
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
PUBLIC_GATEWAY_URL=http://localhost:8001

# ── Authentication (SIWE + JWT) ──────────────────────────────────────────────
# IMPORTANT: Must be changed to a strong random secret when ENVIRONMENT != development
AUTH_JWT_SECRET=dev-insecure-secret-change-in-prod
AUTH_TOKEN_TTL_S=86400
AUTH_DOMAIN=localhost:5173

# ── Infrastructure (PostgreSQL 16 + Redis 7) ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://studio:studio@localhost:5432/studio
REDIS_URL=redis://localhost:6379/0

# ── Avalanche C-Chain Network ────────────────────────────────────────────────
# Supported presets: `avalanche-fuji` (chain 43113) | `avalanche-mainnet` (chain 43114)
NETWORK=avalanche-fuji
# Optional custom RPC endpoint (defaults to the SDK preset RPC for NETWORK)
RPC_URL=

# ── ERC-8183 Escrow Contracts (Optional — Studio-Deployed) ───────────────────
# Leave empty to use x402 (USDC EIP-3009) only. Set all three after running
# `make contracts-deploy-fuji` to enable on-chain ERC-8183 escrow settlement.
COMMERCE_ADDRESS=
ROUTER_ADDRESS=
POLICY_ADDRESS=
# Set to the chain head at first deploy: from 0 the first tick scans the whole chain.
INDEXER_START_BLOCK=0
INDEXER_CONFIRMATIONS=1

# ── Payments & Studio Billing ────────────────────────────────────────────────
DEFAULT_SETTLEMENT_MODE=x402
PAYMENT_ASSET=USDC
STUDIO_FEE_BPS=500
STUDIO_TREASURY_ADDRESS=
FEE_SWEEP_MIN_ATOMIC=1000000

# ── Turnkey Wallets (One Sub-Org per Agent) ──────────────────────────────────
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_API_BASE_URL=https://api.turnkey.com

# ── x402 Relayer Wallet (Settles EIP-3009 Authorizations On-Chain) ───────────
RELAYER_SIGN_WITH=
RELAYER_ORGANIZATION_ID=

# ── Deliverable & Agent URI Storage ──────────────────────────────────────────
# Options: `local` | `ipfs` | `s3`
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.agent-data
STORAGE_API_KEY=
S3_BUCKET=

# ── LLM Worker Configuration ─────────────────────────────────────────────────
# LLM_API_KEY is used for LLM_PROVIDER; provider-specific keys can enable both.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
